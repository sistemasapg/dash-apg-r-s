# Copie este arquivo para .env.local e preencha os valores.
# .env.local esta no .gitignore e nao deve ser commitado nem compartilhado.

# ---------------------------------------------------------------------------
# BANCO (obrigatorio)
# ---------------------------------------------------------------------------
# Connection string do Supabase. Pegue em:
#   Project Settings > Database > Connection pooling > Connection string (URI)
# Use o SESSION POOLER (aws-N-<regiao>.pooler.supabase.com). Os hosts
# db.<ref>.supabase.co so publicam IPv6 e nao resolvem do Vercel.
DATABASE_URL=

# Schema onde as tabelas do dash ficam. Padrao: public.
# Use um schema dedicado (ex.: dash_rs_gupy) se o projeto do Supabase for
# compartilhado com outros sistemas. IMPORTANTE: se voce usar o MESMO banco do
# dash-rs-instituto, o schema TEM de ser diferente, senao um sync sobrescreve
# as fotos do outro.
# DATABASE_SCHEMA=dash_rs_gupy

# ---------------------------------------------------------------------------
# ACESSO AO DASH (obrigatorio em producao)
# ---------------------------------------------------------------------------
# O painel mostra nome e e-mail de candidatos reais. Sem essas duas variaveis
# ele se recusa a subir em producao, para nao expor dado pessoal na internet.
# O login acontece na tela /entrar, nao numa caixa do navegador: a senha nao
# vai na URL e nao precisa de percent-encoding, o @ pode ir cru.
DASH_USUARIO=
DASH_SENHA=

# Assina o cookie de sessao do login. Gere um texto longo e aleatorio, por ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar este valor desloga todo mundo. Sem ele, o dash cai no CRON_SECRET.
DASH_SEGREDO=

# Segredo que autoriza o cron do Vercel a chamar /api/sync.
# Gere qualquer texto longo e aleatorio.
CRON_SECRET=

# ---------------------------------------------------------------------------
# GUPY
# ---------------------------------------------------------------------------
# Token Bearer da API de R&S da Gupy (conta da APG).
# Onde gerar: SETUP > Configuracoes Avancadas > Geracao de Tokens > Gerar Token
# Exige perfil master ou administrador. O token nao expira.
# Ao gerar, habilite a permissao de leitura para: jobs e applications.
GUPY_TOKEN=

# ---------------------------------------------------------------------------
# O RECORTE DA APG: vagas PUBLICADAS que NAO tenham "Joinville" no nome
# ---------------------------------------------------------------------------
# Status de vaga que ENTRAM (lista de permissao, separada por virgula).
# O padrao "published" e o recorte da APG: so o que esta no ar.
# Deixe vazio para aceitar qualquer status.
# GUPY_STATUS_VAGA=published

# Termos no NOME da vaga que ficam DE FORA (separados por virgula).
# Joinville tem dash proprio (dash-rs-instituto); acompanhar a praca aqui
# tambem duplicaria o numero. Ignora acento e maiuscula.
# GUPY_EXCLUIR_VAGA=Joinville

# O contrario: so vagas cujo nome contenha um destes termos.
# Vazio = todas (menos as excluidas acima). Ex.: GUPY_FILTRO_VAGA=Curitiba
# GUPY_FILTRO_VAGA=

# Ajustes opcionais (os padroes funcionam para a maioria dos casos).
# GUPY_API_BASE=https://api.gupy.io
# GUPY_POR_PAGINA=100
# GUPY_CONCORRENCIA=6
# GUPY_CAMPOS=all

# ---------------------------------------------------------------------------
# BANCO: retencao
# ---------------------------------------------------------------------------
# Dias de detalhe por candidato mantidos no banco.
#
# MEDIDO NESTA CONTA (28/08/2026): 15,6 MB por foto, 37.556 candidaturas em 218
# vagas. Os 45 dias que o dash do instituto usa dariam ~700 MB — o banco ja tem
# ~485 MB de outros sistemas da APG. 14 dias = ~220 MB.
#
# Isso afeta SO a lista nominal ("quem avancou", "quem sao os 234"). Total,
# funil, variacao e serie historica saem da tabela agregada, guardada para
# sempre. Confira o custo real com: npm run status
DASH_DIAS_DETALHE=14
